{
 "about": "Mismas respuestas, misma clase de alcance en Python (enso.reach.judge, tests/test_reach_parity.py) y en n8n (n8n/lib/classify.js, reach; n8n/test/lib.test.mjs). body: texto UTF-8; pad: cuántas «x» se le agregan; body_file: archivo bajo python/tests/fixtures; expect: lo que espera el registro (sin él, cualquier formato).",
 "cases": [
  {"name": "403 de Cloudflare con cf-mitigated y cuerpo mínimo", "status": 403, "headers": {"cf-mitigated": "challenge"}, "body": "", "reach": "challenge"},
  {"name": "cf-mitigated en mayúsculas sobre un 200 HTML", "status": 200, "headers": {"CF-Mitigated": "challenge", "content-type": "text/html"}, "body": "<!DOCTYPE html><html><body>", "pad": 800, "reach": "challenge"},
  {"name": "403 sin marcas", "status": 403, "headers": {}, "body": "<html><body>Forbidden</body></html>", "reach": "http-403"},
  {"name": "403 con la página de Cloudflare", "status": 403, "headers": {}, "body": "<html><head><title>Attention Required! | Cloudflare</title></head></html>", "reach": "challenge"},
  {"name": "verificación real de Cloudflare (siofen) con 403", "status": 403, "headers": {"cf-mitigated": "challenge", "content-type": "text/html"}, "body_file": "sources/siofen-icen.html", "reach": "challenge"},
  {"name": "verificación real de Cloudflare (IMARPE) con 200", "status": 200, "headers": {"content-type": "text/html"}, "body_file": "sources/imarpe-home.html", "reach": "challenge"},
  {"name": "página «Un momento» con /cdn-cgi/challenge-platform", "status": 200, "headers": {"content-type": "text/html"}, "body": "<!DOCTYPE html><html><head><title>Un momento…</title></head><body><script src=\"/cdn-cgi/challenge-platform/h/b/orchestrate/chl_page/v1?ray=1\"></script></body></html>", "reach": "challenge"},
  {"name": "«verify you are human» en una página pequeña", "status": 200, "headers": {"content-type": "text/html"}, "body": "<html><body><h1>Please verify you are human</h1></body></html>", "reach": "challenge"},
  {"name": "verificación de seguridad en lugar de un PDF", "status": 200, "headers": {"content-type": "text/html"}, "body": "<!DOCTYPE html><html><head><title>Verificación de seguridad</title></head><body><div class=\"g-recaptcha\"></div></body></html>", "expect": "pdf", "reach": "challenge"},
  {"name": "verificación grande en lugar de un PDF", "status": 200, "headers": {"content-type": "text/html"}, "body": "<html><head><title>Verificación de seguridad</title></head><body>", "pad": 50000, "expect": "pdf", "reach": "challenge"},
  {"name": "página de 45 KB con g-recaptcha arriba (formulario)", "status": 200, "headers": {"content-type": "text/html"}, "body": "<!DOCTYPE html><html><body><form><div class=\"g-recaptcha\"></div></form>", "pad": 46000, "reach": "ok"},
  {"name": "página de 45 KB con g-recaptcha, se esperaba HTML", "status": 200, "headers": {"content-type": "text/html"}, "body": "<!DOCTYPE html><html><body><form><div class=\"g-recaptcha\"></div></form>", "pad": 46000, "expect": "html", "reach": "ok"},
  {"name": "página pequeña con cf-turnstile", "status": 200, "headers": {"content-type": "text/html"}, "body": "<html><body><div class=\"cf-turnstile\"></div></body></html>", "reach": "challenge"},
  {"name": "503 con «Checking your browser»", "status": 503, "headers": {}, "body": "<html><body>Checking your browser before accessing</body></html>", "reach": "challenge"},
  {"name": "HTML donde se esperaba un PDF", "status": 200, "headers": {"content-type": "text/html"}, "body": "<!DOCTYPE html><html><body>", "pad": 2000, "expect": "pdf", "reach": "empty"},
  {"name": "PDF que menciona g-recaptcha", "status": 200, "headers": {"content-type": "application/pdf"}, "body": "%PDF-1.7 g-recaptcha", "pad": 600, "expect": "pdf", "reach": "ok"},
  {"name": "feed con entradas", "status": 200, "headers": {"content-type": "application/rss+xml"}, "body": "<?xml version=\"1.0\"?><rss><channel><title>t</title><item><title>a</title></item></channel></rss>", "expect": "rss", "reach": "ok"},
  {"name": "feed sin entradas", "status": 200, "headers": {"content-type": "application/rss+xml"}, "body": "<?xml version=\"1.0\"?><rss><channel><title>t</title></channel></rss>", "expect": "rss", "reach": "empty"},
  {"name": "HTML donde se esperaba un feed", "status": 200, "headers": {"content-type": "text/html"}, "body": "<!doctype html><html>", "pad": 5000, "expect": "rss", "reach": "empty"},
  {"name": "feed real de Andina", "status": 200, "headers": {"content-type": "application/rss+xml"}, "body_file": "news-probe/andina.xml", "expect": "rss", "reach": "ok"},
  {"name": "JSON esperado", "status": 200, "headers": {"content-type": "application/json"}, "body": "{\"ok\": true}", "expect": "json", "reach": "ok"},
  {"name": "JSON ilegible", "status": 200, "headers": {"content-type": "application/json"}, "body": "{\"ok\": ", "expect": "json", "reach": "empty"},
  {"name": "texto de datos de la NOAA", "status": 200, "headers": {"content-type": "text/plain"}, "body_file": "sources/cpc-oni.txt", "expect": "text", "reach": "ok"},
  {"name": "HTML casi vacío donde se esperaba HTML", "status": 200, "headers": {"content-type": "text/html"}, "body": "<html><body>x</body></html>", "expect": "html", "reach": "empty"},
  {"name": "202 vacío de un antirobots", "status": 202, "headers": {}, "body": "", "expect": "json", "reach": "challenge"},
  {"name": "200 vacío", "status": 200, "headers": {}, "body": "", "reach": "empty"},
  {"name": "404", "status": 404, "headers": {}, "body": "", "reach": "http-4xx"},
  {"name": "401", "status": 401, "headers": {}, "body": "no", "reach": "http-4xx"},
  {"name": "429 sin marcas", "status": 429, "headers": {}, "body": "", "reach": "http-4xx"},
  {"name": "502", "status": 502, "headers": {}, "body": "bad gateway", "reach": "http-5xx"}
 ]
